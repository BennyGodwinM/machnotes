// Mirrored, trimmed copy of the writer app's schema (writer repo owns
// migrations). Deliberately excludes auth-adjacent models — this app only
// ever reads Article/Category/Media, and only rows with status = PUBLISHED.
// Keep this in sync by hand whenever the writer repo's schema changes.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String     @id
  name         String
  slug         String     @unique
  fullSlugPath String     @unique
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  articles     Article[]
  order        Int        @default(0)
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id           String        @id
  title        String
  slug         String        @unique
  compiledHtml String?
  excerpt      String?
  status       ArticleStatus
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  media        Media[]
  publishedAt  DateTime?

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Settings {
  id              String @id
  siteTitle       String
  siteDescription String
}

model Media {
  id        String   @id
  url       String
  filename  String
  width     Int?
  height    Int?
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id])
}
